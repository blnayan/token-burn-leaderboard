{
  "name": "token-burn-leaderboard",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @token-burn/web dev",
    "dev:public": "docker compose --env-file .env.dev -f docker-compose.dev.yml up web",
    "dev:public:down": "docker compose --env-file .env.dev -f docker-compose.dev.yml down",
    "dev:public:reset": "docker compose --env-file .env.dev -f docker-compose.dev.yml down -v",
    "prod:config": "docker compose --env-file .env.prod config",
    "prod:build": "docker compose --env-file .env.prod build",
    "prod:up": "docker compose --env-file .env.prod up -d",
    "prod:down": "docker compose --env-file .env.prod down",
    "prod:migrate": "docker compose --env-file .env.prod --profile tools run --rm migrate",
    "lint": "pnpm --filter @token-burn/shared build && pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @token-burn/shared build && pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
